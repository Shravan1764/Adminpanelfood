<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/SCREEN"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".adduser">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="91sp"
        android:layout_height="92sp"
        android:layout_marginTop="82dp"
        android:contentDescription="@string/login_to_your_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/textView"
        style="@style/TEXT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/yeon_sung"
        android:text="@string/appname"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="@+id/imageView3"
        app:layout_constraintStart_toStartOf="@+id/imageView3"
        app:layout_constraintTop_toBottomOf="@+id/imageView3" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/Tagline"
        android:textColor="@color/green"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="223sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/lato"
        android:text="@string/create_user_admin"
        android:textAlignment="center"
        android:textColor="@color/lgreen"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView2"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/edittxtname"
        android:layout_width="325sp"
        android:layout_height="55sp"
        android:layout_marginTop="15dp"
        android:background="@drawable/txtvbackground"
        android:elevation="20sp"
        android:ems="10"
        android:hint="@string/namelog"
        android:inputType="textEmailAddress"
        android:padding="12sp"
        android:shadowDy="10"
        app:layout_constraintEnd_toEndOf="@+id/textView7"
        app:layout_constraintStart_toStartOf="@+id/textView7"
        app:layout_constraintTop_toBottomOf="@+id/textView7" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="325sp"
        android:layout_height="55sp"
        android:layout_marginTop="15dp"
        android:background="@drawable/txtvbackground"
        android:elevation="20sp"
        android:ems="10"
        android:hint="@string/email_or_phone_number"
        android:inputType="textEmailAddress"
        android:padding="12sp"
        android:shadowDy="10"
        app:layout_constraintEnd_toEndOf="@+id/edittxtname"
        app:layout_constraintStart_toStartOf="@+id/edittxtname"
        app:layout_constraintTop_toBottomOf="@+id/edittxtname" />

    <EditText
        android:id="@+id/editTextTextPassword"
        android:layout_width="325sp"
        android:layout_height="55sp"
        android:layout_marginTop="15dp"
        android:background="@drawable/txtvbackground"
        android:elevation="20sp"
        android:ems="10"
        android:hint="@string/passwordetxt"
        android:inputType="textPassword"
        android:padding="12sp"
        android:shadowDy="10"
        app:layout_constraintEnd_toEndOf="@+id/editTextTextEmailAddress"
        app:layout_constraintStart_toStartOf="@+id/editTextTextEmailAddress"
        app:layout_constraintTop_toBottomOf="@+id/editTextTextEmailAddress" />

    <ImageView
        android:id="@+id/imageView15"
        android:layout_width="37dp"
        android:layout_height="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/backbtn" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/loginbtn"
        android:layout_width="150sp"
        android:layout_height="57sp"
        android:layout_marginTop="30dp"
        android:background="@drawable/button"
        android:text="@string/create_user"
        android:textColor="@color/white"
        android:fontFamily="@font/yeon_sung"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/editTextTextPassword"
        app:layout_constraintStart_toStartOf="@+id/editTextTextPassword"
        app:layout_constraintTop_toBottomOf="@+id/editTextTextPassword" />

</androidx.constraintlayout.widget.ConstraintLayout>