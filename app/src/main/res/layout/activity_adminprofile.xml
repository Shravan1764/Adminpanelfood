<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Adminprofile">


    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="30dp"
        android:layout_height="33dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/backbtn" />

    <TextView
        android:id="@+id/textView20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/yeon_sung"
        android:text="@string/admin_profile"
        android:textColor="@color/black"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView20">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/startedit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato"
                android:text="@string/edit_your_profile"
                android:textSize="20sp"
                android:textColor="@color/green"
                app:drawableStartCompat="@drawable/editprofile" />

            <LinearLayout
                android:id="@+id/nameprof"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="10sp"
                android:layout_marginBottom="10sp"
                android:background="@drawable/txtvbackground"
                android:elevation="25sp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView26"
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/yeon_sung"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/nam"
                    android:textColor="@color/black"
                    android:textSize="30sp" />

                <EditText
                    android:id="@+id/editTextText2"
                    android:layout_width="356dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:ems="10"
                    android:fontFamily="@font/yeon_sung"
                    android:inputType="textMultiLine"
                    android:paddingStart="10sp"
                    android:text="@string/shravan_soni"
                    android:textSize="25sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/adressprof"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10sp"
                android:layout_marginBottom="10sp"
                android:background="@drawable/txtvbackground"
                android:elevation="25sp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView27"
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/yeon_sung"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/address"
                    android:textColor="@color/black"
                    android:textSize="30sp" />

                <EditText
                    android:id="@+id/editTextText3"
                    android:layout_width="356dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:ems="10"
                    android:fontFamily="@font/yeon_sung"
                    android:inputType="textMultiLine"
                    android:paddingStart="10sp"
                    android:padding="8dp"
                    android:text="@string/dumm_addr"
                    android:textSize="20sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/emailprof"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="10sp"
                android:layout_marginBottom="10sp"
                android:background="@drawable/txtvbackground"
                android:elevation="25sp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView28"
                    android:layout_width="221dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/yeon_sung"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/email"
                    android:textColor="@color/black"
                    android:textSize="30sp" />

                <EditText
                    android:id="@+id/editTextText4"
                    android:layout_width="356dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:ems="10"
                    android:fontFamily="@font/yeon_sung"
                    android:inputType="textMultiLine"
                    android:paddingStart="10sp"
                    android:text="@string/mail"
                    android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/password"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="10sp"
                android:layout_marginBottom="10sp"
                android:background="@drawable/txtvbackground"
                android:elevation="15sp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView30"
                    android:layout_width="224dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/yeon_sung"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/password"
                    android:textColor="@color/black"
                    android:textSize="30sp" />

                <EditText
                    android:id="@+id/editTextText8"
                    android:layout_width="356dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:ems="10"
                    android:fontFamily="@font/yeon_sung"
                    android:inputType="textPassword"
                    android:paddingStart="10sp"
                    android:text="@string/num"
                    android:textSize="25sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phonprof"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="10sp"
                android:layout_marginBottom="10sp"
                android:background="@drawable/txtvbackground"
                android:elevation="15sp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView29"
                    android:layout_width="224dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/yeon_sung"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/phoneno"
                    android:textColor="@color/black"
                    android:textSize="30sp" />

                <EditText
                    android:id="@+id/editTextText5"
                    android:layout_width="356dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:ems="10"
                    android:fontFamily="@font/yeon_sung"
                    android:inputType="textMultiLine"
                    android:paddingStart="10sp"
                    android:text="@string/num"
                    android:textSize="25sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:elevation="100dp"
                android:background="@drawable/txtvbackground"
                android:text="@string/save_details"
                android:textColor="@color/lgreen"
                android:textAlignment="center"
                android:textSize="24sp"
                android:fontFamily="@font/yeon_sung"
                android:layout_marginTop="30dp"
                android:layout_marginStart="2sp"
                android:layout_marginEnd="2sp"
                android:layout_marginBottom="35dp"
                />
        </LinearLayout>
</ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>